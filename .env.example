# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# themoviedb.org → Settings → API. Either the v3 "API Key" or the v4 "Read Access Token" works.
TMDB_API_KEY=
# Language for titles and descriptions: en-US, uk-UA, ru-RU…
TMDB_LANGUAGE=en-US

# Optional: omdbapi.com free key, adds IMDb rating
OMDB_API_KEY=
